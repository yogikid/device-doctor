---
import BaseLayout from '@/layouts/BaseLayout.astro';
---

<BaseLayout 
  title="Ringkasan Kesehatan & Diagnosa AI · Device Doctor" 
  description="Rangkuman status kesehatan hardware smartphone, analisis komprehensif didukung AI canggih, dan konsultasi interaktif bersama Dokter Device."
  keywords="analisis kesehatan hp, diagnosa hardware smartphone, ai dokter device, ai smartphone review, ekspor laporan hp bekas"
>
  <div class="flex flex-col gap-4">
    <!-- Header Card -->
    <div class="dd-card p-4 bg-card flex flex-col gap-2" data-accent="neutral">
      <div class="flex items-center gap-3">
        <div class="flex items-center justify-center w-10 h-10 rounded-base bg-main border-2 border-border shadow-xs shrink-0">
          <svg class="w-5 h-5 text-foreground" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <path d="m12 3-1.912 5.813a2 2 0 0 1-1.275 1.275L3 12l5.813 1.912a2 2 0 0 1 1.275 1.275L12 21l1.912-5.813a2 2 0 0 1 1.275-1.275L21 12l-5.813-1.912a2 2 0 0 1-1.275-1.275L12 3Z"/>
            <path d="M5 3v4"/>
            <path d="M19 17v4"/>
            <path d="M3 5h4"/>
            <path d="M17 19h4"/>
          </svg>
        </div>
        <div>
          <h2 class="font-heading text-lg md:text-xl font-black">Ringkasan & Analisis AI</h2>
          <p class="text-xs text-muted-foreground">Evaluasi komprehensif kondisi fisik & spesifikasi dibantu model AI.</p>
        </div>
      </div>
    </div>

    <!-- Status Tally Grid (High Contrast SVGs) -->
    <div class="grid grid-cols-3 gap-2.5 sm:gap-3.5">
      <div class="dd-card p-3.5 bg-card flex flex-col items-center justify-center text-center gap-1.5 shadow-xs" data-accent="healthy">
        <svg class="w-6 h-6 text-foreground" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <path d="M20 13c0 5-3.5 7.5-7.66 8.95a1 1 0 0 1-.67-.01C7.5 20.5 4 18 4 13V6a1 1 0 0 1 1-1c2 0 4.5-1.2 6.24-2.72a1.17 1.17 0 0 1 1.52 0C14.51 3.81 17 5 19 5a1 1 0 0 1 1 1z"/>
          <path d="m9 12 2 2 4-4"/>
        </svg>
        <span id="tally-pass" class="font-data text-2xl font-black">0</span>
        <span class="text-[10px] sm:text-xs font-black uppercase tracking-wider text-muted-foreground">Lolos Normal</span>
      </div>

      <div class="dd-card p-3.5 bg-card flex flex-col items-center justify-center text-center gap-1.5 shadow-xs" data-accent="attention">
        <svg class="w-6 h-6 text-foreground" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <path d="m21.73 18-8-14a2 2 0 0 0-3.48 0l-8 14A2 2 0 0 0 4 21h16a2 2 0 0 0 1.73-3Z"/>
          <path d="M12 9v4"/>
          <path d="M12 17h.01"/>
        </svg>
        <span id="tally-warn" class="font-data text-2xl font-black">0</span>
        <span class="text-[10px] sm:text-xs font-black uppercase tracking-wider text-muted-foreground">Catatan / Izin</span>
      </div>

      <div class="dd-card p-3.5 bg-card flex flex-col items-center justify-center text-center gap-1.5 shadow-xs" data-accent="critical">
        <svg class="w-6 h-6 text-foreground" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="12" cy="12" r="10"/>
          <path d="m15 9-6 6"/>
          <path d="m9 9 6 6"/>
        </svg>
        <span id="tally-fail" class="font-data text-2xl font-black">0</span>
        <span class="text-[10px] sm:text-xs font-black uppercase tracking-wider text-muted-foreground">Bermasalah</span>
      </div>
    </div>

    <!-- AI Analysis Section -->
    <div class="dd-card p-4 bg-card flex flex-col gap-3 relative overflow-hidden" data-accent="neutral">
      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 border-b-2 border-border/40 pb-3">
        <div class="flex items-center gap-2.5">
          <div class="flex items-center justify-center w-8 h-8 rounded-base bg-signature border-2 border-border text-foreground shrink-0 shadow-xs">
            <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <path d="M12 8V4H8"/>
              <rect width="16" height="12" x="4" y="8" rx="2"/>
              <path d="M2 14h2"/>
              <path d="M20 14h2"/>
              <path d="M15 13v2"/>
              <path d="M9 13v2"/>
            </svg>
          </div>
          <div>
            <h3 class="font-heading text-sm sm:text-base font-extrabold">Analisis Medis Perangkat (AI)</h3>
            <p class="text-[11px] text-muted-foreground">Diagnosa cerdas kondisi HP berdasarkan seluruh data spesifikasi & tes fisik.</p>
          </div>
        </div>

        <button id="btn-analyze-ai" class="dd-btn bg-main px-4 py-2 text-xs font-extrabold flex items-center justify-center gap-2 whitespace-nowrap self-start sm:self-auto shrink-0 shadow-xs">
          <svg class="w-4 h-4 text-foreground shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <path d="m12 3-1.912 5.813a2 2 0 0 1-1.275 1.275L3 12l5.813 1.912a2 2 0 0 1 1.275 1.275L12 21l1.912-5.813a2 2 0 0 1 1.275-1.275L21 12l-5.813-1.912a2 2 0 0 1-1.275-1.275L12 3Z"/>
          </svg>
          <span>Minta Analisis AI</span>
        </button>
      </div>

      <!-- Formatted Output Area (Rendered Markdown dengan Typography Khusus) -->
      <div
        id="ai-analysis-box"
        class="min-h-[120px] p-4 bg-secondary-background rounded-base border-2 border-border text-foreground flex flex-col justify-center"
      >
        <div id="ai-placeholder" class="text-center py-6 text-muted-foreground flex flex-col items-center gap-2">
          <svg class="w-7 h-7 text-muted-foreground/60" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="m12 3-1.912 5.813a2 2 0 0 1-1.275 1.275L3 12l5.813 1.912a2 2 0 0 1 1.275 1.275L12 21l1.912-5.813a2 2 0 0 1 1.275-1.275L21 12l-5.813-1.912a2 2 0 0 1-1.275-1.275L12 3Z"/>
          </svg>
          <p class="text-xs">Klik tombol <b>"Minta Analisis AI"</b> untuk mengulas kondisi lengkap HP kamu.</p>
        </div>
        <div id="ai-content" class="hidden ai-formatted flex flex-col gap-2"></div>
      </div>
    </div>

    <!-- Dokter Device Interactive Chat -->
    <div class="dd-card p-4 bg-card flex flex-col gap-3" data-accent="neutral">
      <div class="flex items-center gap-2.5 border-b-2 border-border/40 pb-2.5">
        <div class="flex items-center justify-center w-8 h-8 rounded-base bg-main border-2 border-border text-foreground shrink-0 shadow-xs">
          <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/>
          </svg>
        </div>
        <div>
          <h3 class="font-heading text-sm sm:text-base font-extrabold">Konsultasi Dokter Device (Chat AI)</h3>
          <p class="text-[11px] text-muted-foreground">Tanyakan apa saja tentang spesifikasi teknis, kondisi fisik, atau performa HP kamu.</p>
        </div>
      </div>

      <!-- Chat History Stream -->
      <div id="chat-stream" class="flex flex-col gap-2.5 max-h-96 overflow-y-auto p-2.5 bg-secondary-background rounded-base border-2 border-border text-xs">
        <div class="flex gap-2.5 items-start bg-card p-3 rounded-base border-2 border-border shadow-xs">
          <div class="flex items-center justify-center w-6 h-6 rounded bg-main border border-border text-foreground shrink-0">
            <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <path d="M4.8 2.3A.3.3 0 1 0 5 2H4a2 2 0 0 0-2 2v5a6 6 0 0 0 6 6v0a6 6 0 0 0 6-6V4a2 2 0 0 0-2-2h-1a.2.2 0 1 0 .3.3"/>
              <path d="M8 15v1a6 6 0 0 0 6 6v0a6 6 0 0 0 6-6v-4"/>
              <circle cx="20" cy="10" r="2"/>
            </svg>
          </div>
          <div class="leading-relaxed font-sans text-xs">
            <b>Dokter Device:</b> Halo! Saya sudah membaca seluruh data spesifikasi (IP/ISP, Model, GPU, Layar) dan hasil pengujian HP kamu. Ada yang ingin kamu tanyakan mengenai kondisi fisik atau performa hardware perangkatmu?
          </div>
        </div>
      </div>

      <!-- Chat Input Form -->
      <form id="chat-form" class="flex gap-2">
        <input
          id="chat-input"
          type="text"
          placeholder="Tanya Dokter Device (misal: apakah GPU & layarku aman?)..."
          class="flex-1 bg-secondary-background px-3.5 py-2.5 text-xs rounded-base border-2 border-border font-sans focus:outline-none focus:ring-2 focus:ring-primary"
        />
        <button type="submit" class="dd-btn bg-main px-4 py-2.5 text-xs font-extrabold flex items-center gap-1.5 shrink-0 shadow-xs">
          <svg class="w-4 h-4 text-foreground" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <path d="m22 2-7 20-4-9-9-4Z"/>
            <path d="M22 2 11 13"/>
          </svg>
          <span>Kirim</span>
        </button>
      </form>
    </div>

    <!-- Export & Reset Bar -->
    <div class="flex flex-wrap gap-2.5 justify-between items-center pt-1">
      <div class="flex flex-wrap gap-2">
        <button id="btn-export-json" class="dd-btn bg-secondary-background px-3.5 py-2 text-xs font-extrabold flex items-center gap-1.5 shadow-xs">
          <svg class="w-3.5 h-3.5 text-foreground" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/>
            <polyline points="7 10 12 15 17 10"/>
            <line x1="12" x2="12" y1="15" y2="3"/>
          </svg>
          <span>Unduh JSON</span>
        </button>
        <button id="btn-export-md" class="dd-btn bg-secondary-background px-3.5 py-2 text-xs font-extrabold flex items-center gap-1.5 shadow-xs">
          <svg class="w-3.5 h-3.5 text-foreground" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <path d="M14.5 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7.5L14.5 2z"/>
            <polyline points="14 2 14 8 20 8"/>
          </svg>
          <span>Salin Markdown</span>
        </button>
      </div>

      <button id="btn-reset-all" class="dd-btn bg-critical/20 text-critical border-critical px-3.5 py-2 text-xs font-extrabold flex items-center gap-1.5 shadow-xs">
        <svg class="w-3.5 h-3.5 text-critical" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <path d="M3 12a9 9 0 1 0 9-9 9.75 9.75 0 0 0-6.74 2.74L3 8"/>
          <path d="M3 3v5h5"/>
        </svg>
        <span>Mulai Ulang Tes</span>
      </button>
    </div>
  </div>

  <script>
    import { getSession, resetSession } from '@/lib/diagnostics/store';
    import { requestAnalysis, requestChat, renderMarkdown } from '@/lib/diagnostics/ai';

    const CACHE_KEY_ANALYSIS = 'dd_cached_ai_analysis';
    const CACHE_KEY_CHAT = 'dd_cached_ai_chat';

    function initSummaryView() {
      const s = getSession();
      let p = 0, w = 0, f = 0;

      for (const [k, v] of Object.entries(s.entries)) {
        if (v.status === 'pass') p++;
        else if (v.status === 'warn' || v.status === 'denied' || v.status === 'unsupported') w++;
        else if (v.status === 'fail') f++;
      }

      const tp = document.getElementById('tally-pass');
      const tw = document.getElementById('tally-warn');
      const tf = document.getElementById('tally-fail');
      if (tp) tp.textContent = String(p);
      if (tw) tw.textContent = String(w);
      if (tf) tf.textContent = String(f);

      const btnAnalyze = document.getElementById('btn-analyze-ai');
      const aiContent = document.getElementById('ai-content');
      const aiPlaceholder = document.getElementById('ai-placeholder');

      // 1. Pulihkan Cache Hasil Analisis AI jika ada
      try {
        const cachedAnalysis = localStorage.getItem(CACHE_KEY_ANALYSIS);
        if (cachedAnalysis && aiContent && aiPlaceholder) {
          aiPlaceholder.classList.add('hidden');
          aiContent.classList.remove('hidden');
          aiContent.innerHTML = renderMarkdown(cachedAnalysis);
        }
      } catch {}

      btnAnalyze?.addEventListener('click', async () => {
        if (!aiContent || !aiPlaceholder || !btnAnalyze) return;
        aiPlaceholder.classList.add('hidden');
        aiContent.classList.remove('hidden');
        aiContent.innerHTML = '<span class="animate-pulse">Sedang menganalisis snapshot perangkat dengan model AI…</span>';
        btnAnalyze.setAttribute('disabled', 'true');

        let fullText = '';
        await requestAnalysis({
          onChunk: (chunk: string) => {
            fullText += chunk;
            if (aiContent) {
              aiContent.innerHTML = renderMarkdown(fullText);
            }
          },
          onDone: () => {
            btnAnalyze.removeAttribute('disabled');
            try {
              localStorage.setItem(CACHE_KEY_ANALYSIS, fullText);
            } catch {}
          },
          onError: (err: string) => {
            btnAnalyze.removeAttribute('disabled');
            if (aiContent) {
              aiContent.innerHTML = `<p class="text-critical font-bold">${err}</p>`;
            }
          }
        });
      });

      // 2. Chat Assistant & Cache History
      const chatForm = document.getElementById('chat-form') as HTMLFormElement | null;
      const chatInput = document.getElementById('chat-input') as HTMLInputElement | null;
      const chatStream = document.getElementById('chat-stream');
      let chatHistory: { role: 'user' | 'assistant'; content: string }[] = [];

      // Pulihkan Cache Chat History jika ada
      try {
        const savedChat = localStorage.getItem(CACHE_KEY_CHAT);
        if (savedChat && chatStream) {
          chatHistory = JSON.parse(savedChat);
          for (const msg of chatHistory) {
            if (msg.role === 'user') {
              const uBubble = document.createElement('div');
              uBubble.className = 'flex gap-2 items-start bg-main p-2.5 rounded-base border-2 border-border shadow-xs self-end max-w-[85%]';
              uBubble.innerHTML = `<div class="leading-relaxed font-sans text-xs"><b>Kamu:</b> ${msg.content}</div>`;
              chatStream.append(uBubble);
            } else {
              const aBubble = document.createElement('div');
              aBubble.className = 'flex gap-2.5 items-start bg-card p-3 rounded-base border-2 border-border shadow-xs max-w-[90%]';
              aBubble.innerHTML = `
                <div class="flex items-center justify-center w-6 h-6 rounded bg-main border border-border text-foreground shrink-0">
                  <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M4.8 2.3A.3.3 0 1 0 5 2H4a2 2 0 0 0-2 2v5a6 6 0 0 0 6 6v0a6 6 0 0 0 6-6V4a2 2 0 0 0-2-2h-1a.2.2 0 1 0 .3.3"/>
                    <path d="M8 15v1a6 6 0 0 0 6 6v0a6 6 0 0 0 6-6v-4"/>
                    <circle cx="20" cy="10" r="2"/>
                  </svg>
                </div>
                <div class="ai-text leading-relaxed font-sans text-xs ai-formatted w-full">${renderMarkdown(msg.content)}</div>
              `;
              chatStream.append(aBubble);
            }
          }
          chatStream.scrollTo({ top: chatStream.scrollHeight });
        }
      } catch {}

      chatForm?.addEventListener('submit', async (e) => {
        e.preventDefault();
        const q = chatInput?.value?.trim();
        if (!q) return;

        if (chatInput) chatInput.value = '';

        const userBubble = document.createElement('div');
        userBubble.className = 'flex gap-2 items-start bg-main p-2.5 rounded-base border-2 border-border shadow-xs self-end max-w-[85%]';
        userBubble.innerHTML = `<div class="leading-relaxed font-sans text-xs"><b>Kamu:</b> ${q}</div>`;
        chatStream?.append(userBubble);
        chatHistory.push({ role: 'user', content: q });

        const aiBubble = document.createElement('div');
        aiBubble.className = 'flex gap-2.5 items-start bg-card p-3 rounded-base border-2 border-border shadow-xs max-w-[90%]';
        aiBubble.innerHTML = `
          <div class="flex items-center justify-center w-6 h-6 rounded bg-main border border-border text-foreground shrink-0">
            <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <path d="M4.8 2.3A.3.3 0 1 0 5 2H4a2 2 0 0 0-2 2v5a6 6 0 0 0 6 6v0a6 6 0 0 0 6-6V4a2 2 0 0 0-2-2h-1a.2.2 0 1 0 .3.3"/>
              <path d="M8 15v1a6 6 0 0 0 6 6v0a6 6 0 0 0 6-6v-4"/>
              <circle cx="20" cy="10" r="2"/>
            </svg>
          </div>
          <div class="ai-text leading-relaxed font-sans text-xs ai-formatted w-full"><span class="animate-pulse">Mengetik jawaban…</span></div>
        `;
        chatStream?.append(aiBubble);
        chatStream?.scrollTo({ top: chatStream.scrollHeight, behavior: 'smooth' });

        const textContainer = aiBubble.querySelector('.ai-text');
        let replyText = '';

        await requestChat(q, chatHistory, {
          onChunk: (chunk: string) => {
            replyText += chunk;
            if (textContainer) {
              textContainer.innerHTML = renderMarkdown(replyText);
            }
            chatStream?.scrollTo({ top: chatStream.scrollHeight });
          },
          onDone: () => {
            chatHistory.push({ role: 'assistant', content: replyText });
            try {
              localStorage.setItem(CACHE_KEY_CHAT, JSON.stringify(chatHistory));
            } catch {}
          },
          onError: (err: string) => {
            if (textContainer) {
              textContainer.innerHTML = `<span class="text-critical font-bold">Gagal: ${err}</span>`;
            }
          }
        });
      });

      document.getElementById('btn-export-json')?.addEventListener('click', () => {
        const dataStr = 'data:text/json;charset=utf-8,' + encodeURIComponent(JSON.stringify(getSession(), null, 2));
        const dl = document.createElement('a');
        dl.setAttribute('href', dataStr);
        dl.setAttribute('download', `device-doctor-report-${Date.now()}.json`);
        dl.click();
      });

      document.getElementById('btn-export-md')?.addEventListener('click', () => {
        const s = getSession();
        let md = `# Laporan Diagnostik Device Doctor\nTanggal: ${new Date().toLocaleString()}\n\n`;
        md += `| Uji / Komponen | Status | Nilai | Catatan |\n|---|---|---|---|\n`;
        for (const [k, v] of Object.entries(s.entries)) {
          md += `| ${k} | ${v.status} | ${v.value ?? '-'} | ${v.note ?? '-'} |\n`;
        }
        navigator.clipboard.writeText(md).then(() => {
          alert('Laporan format Markdown berhasil disalin ke clipboard!');
        });
      });

      document.getElementById('btn-reset-all')?.addEventListener('click', () => {
        if (confirm('Reset semua hasil tes dan mulai ulang dari awal?')) {
          resetSession();
          try {
            localStorage.removeItem(CACHE_KEY_ANALYSIS);
            localStorage.removeItem(CACHE_KEY_CHAT);
          } catch {}
          window.location.reload();
        }
      });
    }

    document.addEventListener('astro:page-load', () => {
      initSummaryView();
    });
  </script>
</BaseLayout>

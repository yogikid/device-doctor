---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { 
  MapPin, 
  Navigation, 
  Compass, 
  AlertCircle, 
  ExternalLink, 
  RotateCw,
  Layers,
  ShieldCheck
} from 'lucide-react';
---

<BaseLayout 
  title="Peta Interaktif & Presisi Satelit GPS · Device Doctor" 
  description="Uji presisi chip GPS/GNSS smartphone, radius akurasi sinyal satelit, dan visualisasi titik koordinat pada peta interaktif OpenStreetMap langsung di browser."
  keywords="cek gps hp, tes akurasi gps, tes satelit gnss smartphone, peta openstreetmap lokal, cek koordinat latitude longitude online"
>
  <div class="flex flex-col gap-4">
    <!-- Header Card -->
    <div class="dd-card p-4 bg-card flex flex-col gap-2" data-accent="neutral">
      <div class="flex items-center justify-between">
        <div class="flex items-center gap-2">
          <div class="p-1.5 rounded-base bg-main border-2 border-border">
            <MapPin className="w-5 h-5 text-primary" />
          </div>
          <div>
            <h2 class="font-heading text-lg font-black">Peta & Kuncian GPS</h2>
            <p class="text-xs text-muted-foreground">Uji hardware GNSS/GPS dengan visualisasi radius akurasi.</p>
          </div>
        </div>
      </div>
      <p class="text-xs text-muted-foreground leading-relaxed">
        Data lokasi diproses 100% lokal di browser HP kamu dan tidak pernah disimpan atau dikirim ke server mana pun.
      </p>
    </div>

    <!-- Map Container Card -->
    <div class="dd-card p-2 bg-card flex flex-col gap-3 relative overflow-hidden" data-accent="neutral">
      <!-- Peta OpenStreetMap (Direct Embed) -->
      <div class="relative w-full h-80 sm:h-96 rounded-base border-2 border-border bg-secondary-background overflow-hidden">
        <div id="map-placeholder" class="absolute inset-0 flex flex-col items-center justify-center p-4 text-center z-20 bg-secondary-background">
          <Compass className="w-10 h-10 text-muted-foreground animate-pulse mb-2" />
          <p class="font-heading text-sm font-bold">Peta Belum Aktif</p>
          <p class="text-xs text-muted-foreground mt-1 max-w-xs">
            Tekan tombol <b>"Kunci Posisi & Buka Peta"</b> di bawah untuk mengambil koordinat dan menampilkan peta interaktif.
          </p>
        </div>

        <iframe
          id="osm-iframe"
          class="hidden w-full h-full border-0 relative z-10"
          loading="lazy"
          title="Peta Lokasi Perangkat"
        ></iframe>
      </div>

      <!-- Action Button & Coordinates Display -->
      <div class="flex flex-col gap-2.5 p-2">
        <button id="btn-get-loc" class="dd-btn bg-main py-2.5 px-4 text-xs font-extrabold flex items-center justify-center gap-2 w-full">
          <Navigation className="w-4 h-4 text-primary" />
          <span>Kunci Posisi & Buka Peta</span>
        </button>

        <div id="loc-details" class="hidden flex-col gap-2 p-3 bg-secondary-background rounded-base border-2 border-border font-data text-xs">
          <div class="flex justify-between border-b border-border/30 pb-1.5">
            <span class="text-muted-foreground flex items-center gap-1.5">
              <Compass className="w-3.5 h-3.5 text-muted-foreground" />
              Garis Lintang (Latitude):
            </span>
            <span id="loc-lat" class="font-bold">—</span>
          </div>
          <div class="flex justify-between border-b border-border/30 pb-1.5">
            <span class="text-muted-foreground flex items-center gap-1.5">
              <Compass className="w-3.5 h-3.5 text-muted-foreground" />
              Garis Bujur (Longitude):
            </span>
            <span id="loc-lon" class="font-bold">—</span>
          </div>
          <div class="flex justify-between border-b border-border/30 pb-1.5">
            <span class="text-muted-foreground flex items-center gap-1.5">
              <ShieldCheck className="w-3.5 h-3.5 text-healthy" />
              Radius Presisi (Akurasi):
            </span>
            <span id="loc-acc" class="font-bold text-healthy">—</span>
          </div>
          <div class="flex justify-between items-center">
            <span class="text-muted-foreground flex items-center gap-1.5">
              <Layers className="w-3.5 h-3.5 text-muted-foreground" />
              Kualitas Kuncian:
            </span>
            <span id="loc-status" class="font-bold">Terkunci</span>
          </div>
          <div class="pt-1 flex gap-2">
            <a
              id="loc-ext-link"
              href="#"
              target="_blank"
              rel="noopener noreferrer"
              class="dd-btn bg-card text-foreground px-3 py-1.5 text-[11px] font-bold flex items-center gap-1.5 w-full justify-center shadow-xs"
            >
              <ExternalLink className="w-3.5 h-3.5 text-primary" />
              <span>Buka di OpenStreetMap</span>
            </a>
          </div>
        </div>

        <p id="loc-err" class="hidden text-xs text-critical font-bold p-2.5 bg-critical/20 rounded-base border-2 border-border font-data flex items-center gap-2">
          <AlertCircle className="w-4 h-4 text-critical shrink-0" />
          <span id="loc-err-txt"></span>
        </p>
      </div>
    </div>

    <!-- Tips GNSS/GPS Hardware -->
    <div class="dd-card p-4 bg-card flex flex-col gap-2" data-accent="neutral">
      <h3 class="font-heading text-xs font-bold uppercase tracking-wider text-muted-foreground flex items-center gap-1.5">
        <AlertCircle className="w-3.5 h-3.5 text-muted-foreground" />
        Info Pengujian Sensor GPS
      </h3>
      <ul class="text-xs text-muted-foreground space-y-1.5 list-disc list-inside leading-relaxed">
        <li>Akurasi <b>&le; 10 meter</b> menandakan kuncian multi-satelit GNSS (GPS/GLONASS/Galileo) optimal di luar ruangan.</li>
        <li>Jika akurasi <b>&gt; 25 meter</b>, perangkat kemungkinan mengandalkan estimasi BTS seluler / WiFi triangulasi.</li>
      </ul>
    </div>
  </div>

  <script>
    import { setEntry } from '@/lib/diagnostics/store';

    function bindLocationEvents() {
      const btn = document.getElementById('btn-get-loc');
      const placeholder = document.getElementById('map-placeholder');
      const iframe = document.getElementById('osm-iframe') as HTMLIFrameElement | null;
      const details = document.getElementById('loc-details');
      const errBox = document.getElementById('loc-err');
      const errTxt = document.getElementById('loc-err-txt');
      const latEl = document.getElementById('loc-lat');
      const lonEl = document.getElementById('loc-lon');
      const accEl = document.getElementById('loc-acc');
      const statusEl = document.getElementById('loc-status');
      const extLink = document.getElementById('loc-ext-link') as HTMLAnchorElement | null;

      function showMap(lat: number, lon: number, accuracy: number) {
        if (placeholder) placeholder.style.display = 'none';
        if (iframe) {
          iframe.classList.remove('hidden');
          const bboxDelta = 0.005;
          const bbox = `${lon - bboxDelta},${lat - bboxDelta},${lon + bboxDelta},${lat + bboxDelta}`;
          iframe.src = `https://www.openstreetmap.org/export/embed.html?bbox=${bbox}&layer=mapnik&marker=${lat},${lon}`;
        }
        if (details) {
          details.classList.remove('hidden');
          details.classList.add('flex');
        }
        if (errBox) errBox.classList.add('hidden');

        if (latEl) latEl.textContent = lat.toFixed(6);
        if (lonEl) lonEl.textContent = lon.toFixed(6);
        if (accEl) accEl.textContent = `± ${accuracy.toFixed(0)} meter`;
        if (statusEl) {
          statusEl.textContent = accuracy <= 15 ? 'Presisi Tinggi (GNSS Fix)' : 'Presisi Sedang / Estimasi Jaringan';
        }
        if (extLink) {
          extLink.href = `https://www.openstreetmap.org/?mlat=${lat}&mlon=${lon}#map=17/${lat}/${lon}`;
        }

        setEntry('location', {
          status: accuracy <= 25 ? 'pass' : 'warn',
          value: `±${accuracy.toFixed(0)}m (${lat.toFixed(4)}, ${lon.toFixed(4)})`,
          note: `Koordinat GPS: Lat ${lat.toFixed(6)}, Lon ${lon.toFixed(6)} dengan radius akurasi ±${accuracy.toFixed(0)} meter.`,
        });
      }

      btn?.addEventListener('click', () => {
        if (!('geolocation' in navigator)) {
          if (errBox && errTxt) {
            errTxt.textContent = 'Fitur Geolocation tidak didukung di browser ini.';
            errBox.classList.remove('hidden');
          }
          return;
        }

        btn.setAttribute('disabled', 'true');
        btn.innerHTML = '<span>Mencari Kuncian Satelit…</span>';

        navigator.geolocation.getCurrentPosition(
          (pos) => {
            btn.removeAttribute('disabled');
            btn.innerHTML = '<span>Perbarui Kuncian Posisi</span>';
            showMap(pos.coords.latitude, pos.coords.longitude, pos.coords.accuracy);
          },
          (err) => {
            btn.removeAttribute('disabled');
            btn.innerHTML = '<span>Kunci Posisi & Buka Peta</span>';
            if (errBox && errTxt) {
              errTxt.textContent = err.code === err.PERMISSION_DENIED
                ? 'Izin lokasi ditolak. Buka izin lokasi di address bar browser.'
                : `Gagal membaca GPS (${err.message}).`;
              errBox.classList.remove('hidden');
            }
            setEntry('location', {
              status: err.code === err.PERMISSION_DENIED ? 'denied' : 'fail',
              note: 'Akses lokasi tidak berhasil didapatkan.',
            });
          },
          { enableHighAccuracy: true, timeout: 20000, maximumAge: 0 },
        );
      });
    }

    document.addEventListener('astro:page-load', () => {
      bindLocationEvents();
    });
  </script>
</BaseLayout>

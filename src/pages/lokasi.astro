---
import BaseLayout from '@/layouts/BaseLayout.astro';
---

<BaseLayout 
  title="Peta Interaktif & Presisi Satelit GPS · Device Doctor" 
  description="Uji presisi chip GPS/GNSS smartphone, radius akurasi sinyal satelit, dan visualisasi titik koordinat pada peta interaktif OpenStreetMap langsung di browser."
  keywords="cek gps hp, tes akurasi gps, tes satelit gnss smartphone, peta openstreetmap lokal, cek koordinat latitude longitude online"
>
  <div class="flex flex-col gap-6">
    <!-- Header Card -->
    <div class="dd-card p-5 sm:p-6 bg-card flex flex-col gap-2.5" data-accent="neutral">
      <div class="flex items-center gap-3">
        <div class="flex items-center justify-center w-11 h-11 rounded-base bg-main border-2 border-border shadow-xs shrink-0">
          <svg class="w-6 h-6 text-foreground" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"/>
            <circle cx="12" cy="10" r="3"/>
          </svg>
        </div>
        <div>
          <h2 class="font-heading text-lg sm:text-xl md:text-2xl font-black">Peta & Kuncian GPS</h2>
          <p class="text-xs sm:text-sm text-muted-foreground">Uji presisi hardware chip GNSS/GPS dengan peta interaktif real-time.</p>
        </div>
      </div>
      <p class="text-xs sm:text-sm text-muted-foreground leading-relaxed pt-1">
        Data koordinat diproses 100% lokal di browser kamu dan tidak disimpan di server mana pun.
      </p>
    </div>

    <!-- Map Container Card -->
    <div class="dd-card p-3 sm:p-4 bg-card flex flex-col gap-4 relative overflow-hidden" data-accent="neutral">
      <!-- Peta OpenStreetMap (Direct Embed) -->
      <div class="relative w-full h-80 sm:h-96 md:h-[420px] rounded-base border-2 border-border bg-secondary-background overflow-hidden shadow-inner">
        <div id="map-placeholder" class="absolute inset-0 flex flex-col items-center justify-center p-6 text-center z-20 bg-secondary-background">
          <svg class="w-12 h-12 text-muted-foreground/60 animate-pulse mb-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="12" cy="12" r="10"/>
            <polygon points="16.24 7.76 14.12 14.12 7.76 16.24 9.88 9.88 16.24 7.76"/>
          </svg>
          <p class="font-heading text-base font-extrabold text-foreground">Peta Belum Aktif</p>
          <p class="text-xs sm:text-sm text-muted-foreground mt-1 max-w-sm">
            Tekan tombol <b>"Kunci Posisi & Buka Peta"</b> di bawah untuk mengunci koordinat satelit GPS dan memuat peta OpenStreetMap.
          </p>
        </div>

        <iframe
          id="osm-iframe"
          class="hidden w-full h-full border-0 relative z-10"
          loading="lazy"
          title="Peta Lokasi Perangkat"
        ></iframe>
      </div>

      <!-- Action Button & Coordinates Display (High Contrast, Bold Dark Text, No Faint Neon Green!) -->
      <div class="flex flex-col gap-3 p-1">
        <button id="btn-get-loc" class="dd-btn bg-main py-3 px-5 text-xs sm:text-sm font-extrabold flex items-center justify-center gap-2 w-full shadow-xs">
          <svg class="w-4 h-4 text-foreground shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <polygon points="3 11 22 2 13 21 11 13 3 11"/>
          </svg>
          <span>Kunci Posisi & Buka Peta</span>
        </button>

        <div id="loc-details" class="hidden flex-col gap-2.5 p-4 bg-card rounded-base border-2 border-border shadow-xs">
          <div class="flex justify-between items-center border-b-2 border-border/20 pb-2">
            <span class="text-xs font-semibold text-muted-foreground flex items-center gap-2">
              <svg class="w-4 h-4 text-foreground" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="12" cy="12" r="10"/>
                <polygon points="16.24 7.76 14.12 14.12 7.76 16.24 9.88 9.88 16.24 7.76"/>
              </svg>
              Garis Lintang (Latitude):
            </span>
            <span id="loc-lat" class="font-data text-xs sm:text-sm font-black text-foreground">—</span>
          </div>

          <div class="flex justify-between items-center border-b-2 border-border/20 pb-2">
            <span class="text-xs font-semibold text-muted-foreground flex items-center gap-2">
              <svg class="w-4 h-4 text-foreground" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="12" cy="12" r="10"/>
                <polygon points="16.24 7.76 14.12 14.12 7.76 16.24 9.88 9.88 16.24 7.76"/>
              </svg>
              Garis Bujur (Longitude):
            </span>
            <span id="loc-lon" class="font-data text-xs sm:text-sm font-black text-foreground">—</span>
          </div>

          <div class="flex justify-between items-center border-b-2 border-border/20 pb-2">
            <span class="text-xs font-semibold text-muted-foreground flex items-center gap-2">
              <svg class="w-4 h-4 text-foreground" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                <path d="M20 13c0 5-3.5 7.5-7.66 8.95a1 1 0 0 1-.67-.01C7.5 20.5 4 18 4 13V6a1 1 0 0 1 1-1c2 0 4.5-1.2 6.24-2.72a1.17 1.17 0 0 1 1.52 0C14.51 3.81 17 5 19 5a1 1 0 0 1 1 1z"/>
                <path d="m9 12 2 2 4-4"/>
              </svg>
              Radius Presisi (Akurasi GPS):
            </span>
            <!-- Teks Kontras Gelap Tegas & Nyaman di Mata -->
            <span id="loc-acc" class="font-data text-xs sm:text-sm font-black text-foreground bg-main/40 px-2 py-0.5 rounded border border-border">—</span>
          </div>

          <div class="flex justify-between items-center border-b-2 border-border/20 pb-2">
            <span class="text-xs font-semibold text-muted-foreground flex items-center gap-2">
              <svg class="w-4 h-4 text-foreground" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                <polygon points="12 2 2 7 12 12 22 7 12 2"/>
                <polyline points="2 17 12 22 22 17"/>
                <polyline points="2 12 12 17 22 12"/>
              </svg>
              Kualitas Kuncian Sinyal:
            </span>
            <span id="loc-status" class="font-sans text-xs sm:text-sm font-bold text-foreground">Terkunci</span>
          </div>

          <div class="pt-1.5 flex gap-2">
            <a
              id="loc-ext-link"
              href="#"
              target="_blank"
              rel="noopener noreferrer"
              class="dd-btn bg-secondary-background text-foreground px-4 py-2 text-xs font-extrabold flex items-center gap-2 w-full justify-center shadow-xs hover:bg-card"
            >
              <svg class="w-4 h-4 text-foreground" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/>
                <polyline points="15 3 21 3 21 9"/>
                <line x1="10" x2="21" y1="14" y2="3"/>
              </svg>
              <span>Buka Tampilan Penuh di OpenStreetMap</span>
            </a>
          </div>
        </div>

        <p id="loc-err" class="hidden text-xs sm:text-sm text-foreground font-bold p-3 bg-destructive/40 rounded-base border-2 border-border font-data flex items-center gap-2.5">
          <svg class="w-4 h-4 text-foreground shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="12" cy="12" r="10"/>
            <line x1="12" x2="12" y1="8" y2="12"/>
            <line x1="12" x2="12.01" y1="16" y2="16"/>
          </svg>
          <span id="loc-err-txt"></span>
        </p>
      </div>
    </div>

    <!-- Tips GNSS/GPS Hardware -->
    <div class="dd-card p-5 bg-card flex flex-col gap-2.5" data-accent="neutral">
      <h3 class="font-heading text-xs font-extrabold uppercase tracking-wider text-muted-foreground flex items-center gap-2">
        <svg class="w-4 h-4 text-muted-foreground" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="12" cy="12" r="10"/>
          <line x1="12" x2="12" y1="8" y2="12"/>
          <line x1="12" x2="12.01" y1="16" y2="16"/>
        </svg>
        Info Pengujian Sensor GPS
      </h3>
      <ul class="text-xs sm:text-sm text-muted-foreground space-y-1.5 list-disc list-inside leading-relaxed">
        <li>Akurasi <b>&le; 15 meter</b> menandakan kuncian multi-satelit GNSS (GPS/GLONASS/Galileo) optimal di luar ruangan.</li>
        <li>Jika akurasi <b>&gt; 25 meter</b>, perangkat kemungkinan berada di dalam ruangan dan mengandalkan estimasi BTS seluler / Wi-Fi.</li>
      </ul>
    </div>
  </div>

  <script>
    import { setEntry } from '@/lib/diagnostics/store';

    function bindLocationEvents() {
      const btn = document.getElementById('btn-get-loc');
      const placeholder = document.getElementById('map-placeholder');
      const iframe = document.getElementById('osm-iframe') as HTMLIFrameElement | null;
      const details = document.getElementById('loc-details');
      const errBox = document.getElementById('loc-err');
      const errTxt = document.getElementById('loc-err-txt');
      const latEl = document.getElementById('loc-lat');
      const lonEl = document.getElementById('loc-lon');
      const accEl = document.getElementById('loc-acc');
      const statusEl = document.getElementById('loc-status');
      const extLink = document.getElementById('loc-ext-link') as HTMLAnchorElement | null;

      function showMap(lat: number, lon: number, accuracy: number) {
        if (placeholder) placeholder.style.display = 'none';
        if (iframe) {
          iframe.classList.remove('hidden');
          const bboxDelta = 0.005;
          const bbox = `${lon - bboxDelta},${lat - bboxDelta},${lon + bboxDelta},${lat + bboxDelta}`;
          iframe.src = `https://www.openstreetmap.org/export/embed.html?bbox=${bbox}&layer=mapnik&marker=${lat},${lon}`;
        }
        if (details) {
          details.classList.remove('hidden');
          details.classList.add('flex');
        }
        if (errBox) errBox.classList.add('hidden');

        if (latEl) latEl.textContent = lat.toFixed(6);
        if (lonEl) lonEl.textContent = lon.toFixed(6);
        if (accEl) accEl.textContent = `± ${accuracy.toFixed(0)} meter`;
        if (statusEl) {
          statusEl.textContent = accuracy <= 20 ? 'Presisi Tinggi (Kuncian GNSS Satelit)' : 'Presisi Sedang / Estimasi Jaringan';
        }
        if (extLink) {
          extLink.href = `https://www.openstreetmap.org/?mlat=${lat}&mlon=${lon}#map=17/${lat}/${lon}`;
        }

        setEntry('location', {
          status: accuracy <= 25 ? 'pass' : 'warn',
          value: `±${accuracy.toFixed(0)}m (${lat.toFixed(4)}, ${lon.toFixed(4)})`,
          note: `Koordinat GPS: Lat ${lat.toFixed(6)}, Lon ${lon.toFixed(6)} dengan radius akurasi ±${accuracy.toFixed(0)} meter.`,
        });
      }

      btn?.addEventListener('click', () => {
        if (!('geolocation' in navigator)) {
          if (errBox && errTxt) {
            errTxt.textContent = 'Fitur Geolocation tidak didukung di browser ini.';
            errBox.classList.remove('hidden');
          }
          return;
        }

        btn.setAttribute('disabled', 'true');
        btn.innerHTML = '<span>Mencari Kuncian Satelit…</span>';

        navigator.geolocation.getCurrentPosition(
          (pos) => {
            btn.removeAttribute('disabled');
            btn.innerHTML = '<span>Perbarui Kuncian Posisi</span>';
            showMap(pos.coords.latitude, pos.coords.longitude, pos.coords.accuracy);
          },
          (err) => {
            btn.removeAttribute('disabled');
            btn.innerHTML = '<span>Kunci Posisi & Buka Peta</span>';
            if (errBox && errTxt) {
              errTxt.textContent = err.code === err.PERMISSION_DENIED
                ? 'Izin lokasi ditolak. Buka izin lokasi di address bar browser.'
                : `Gagal membaca GPS (${err.message}).`;
              errBox.classList.remove('hidden');
            }
            setEntry('location', {
              status: err.code === err.PERMISSION_DENIED ? 'denied' : 'fail',
              note: 'Akses lokasi tidak berhasil didapatkan.',
            });
          },
          { enableHighAccuracy: true, timeout: 20000, maximumAge: 0 },
        );
      });
    }

    document.addEventListener('astro:page-load', () => {
      bindLocationEvents();
    });
  </script>
</BaseLayout>

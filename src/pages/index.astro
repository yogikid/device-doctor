---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { 
  Globe,
  Battery, 
  Wifi, 
  Smartphone, 
  Monitor, 
  Cpu, 
  Database, 
  Radio, 
  Film, 
  Camera, 
  Layers, 
  Gauge, 
  Clock, 
  Flame,
  Volume2
} from 'lucide-react';

const categories = [
  { id: 'card-ip', title: 'Alamat IP & Jaringan Provider', desc: 'Informasi IP Publik, ISP, ASN & Edge Datacenter.', icon: Globe },
  { id: 'card-battery', title: 'Baterai & Manajemen Daya', desc: 'Level baterai real-time & status pengisian daya.', icon: Battery },
  { id: 'card-connection', title: 'Sinyal & Transmisi Jaringan', desc: 'Media koneksi fisik, bandwidth downlink & latensi RTT.', icon: Wifi },
  { id: 'card-device', title: 'Perangkat, CPU & Arsitektur', desc: 'Vendor, model komersial, core CPU & RAM.', icon: Smartphone },
  { id: 'card-display', title: 'Layar & Spesifikasi Visual', desc: 'Resolusi fisik, refresh rate Hz, gamut & HDR.', icon: Monitor },
  { id: 'card-gpu', title: 'GPU & WebGL2 3D Acceleration', desc: 'Chipset grafis hardware & batas render buffer.', icon: Cpu },
  { id: 'card-storage', title: 'Penyimpanan & Kuota Browser', desc: 'Alokasi storage origin & persistensi data.', icon: Database },
  { id: 'card-sensors', title: 'Sensor Gerak & Antarmuka Input', desc: 'Gyroscope, akselerometer, multi-touch & haptic.', icon: Radio },
  { id: 'card-audio', title: 'Audio & Multimedia Hardware', desc: 'Web Audio framework, latency & kanal stereo.', icon: Volume2 },
  { id: 'card-codecs', title: 'Dukungan Video & Audio Codecs', desc: 'Kemampuan hardware decode AV1, HEVC, VP9, H.264.', icon: Film },
  { id: 'card-capabilities', title: 'Fitur Browser & Web Platform', desc: 'PWA, WASM, Biometrik FIDO2 & Security Context.', icon: Layers },
  { id: 'card-memory', title: 'Memori JavaScript Heap Engine', desc: 'Pemakaian memori V8 & batas aman tab.', icon: Gauge },
  { id: 'card-locale', title: 'Waktu, Zona Waktu & Regional', desc: 'Waktu sistem, timezone, bahasa & kalender.', icon: Clock },
];
---

<BaseLayout 
  title="Spesifikasi Lengkap Hardware & Jaringan · Device Doctor"
  description="Inspeksi komprehensif 14 kategori hardware, identitas model HP, ISP provider, chipset GPU, refresh rate layar, dan sensor perangkat secara langsung di browser."
  keywords="spesifikasi hp online, cek model samsung xiaomi poco, cek gpu hp webgl, cek refresh rate layar hz, cek isp ip publik online"
>
  <div class="flex flex-col gap-6">
    <!-- Hero Banner Spesifikasi -->
    <div class="dd-card p-5 sm:p-6 bg-card flex flex-col gap-2.5" data-accent="neutral">
      <div class="flex items-center gap-3">
        <div class="flex items-center justify-center w-11 h-11 rounded-base bg-main border-2 border-border shadow-xs shrink-0">
          <Smartphone className="w-6 h-6 text-foreground" />
        </div>
        <div>
          <h2 class="font-heading text-lg sm:text-xl md:text-2xl font-black">Spesifikasi Lengkap Perangkat</h2>
          <p class="text-xs sm:text-sm text-muted-foreground">Analisis mendalam 14 kategori hardware, jaringan edge, dan Web APIs secara jujur.</p>
        </div>
      </div>
      <p class="text-xs sm:text-sm text-muted-foreground leading-relaxed pt-1">
        Semua data diinspeksi secara real-time langsung melalui browser tanpa instalasi aplikasi tambahan.
      </p>
    </div>

    <!-- Grid Kartu Spesifikasi: 1 Kolom di Mobile, 2 Kolom di Tablet, 3 Kolom di Desktop Lebar -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4 sm:gap-5 md:gap-6 items-start">
      {categories.map((cat) => {
        const Icon = cat.icon;
        return (
          <div id={cat.id} class="dd-card p-4 sm:p-5 bg-card flex flex-col gap-3 h-full shadow-xs" data-accent="neutral">
            <div class="flex items-center justify-between gap-2 border-b-2 border-border/40 pb-2.5">
              <div class="flex items-center gap-2.5">
                <div class="p-2 rounded-base bg-secondary-background border-2 border-border shadow-2xs shrink-0">
                  <Icon className="w-4 h-4 sm:w-5 sm:h-5 text-foreground" />
                </div>
                <div>
                  <h3 class="font-heading text-sm sm:text-base font-extrabold leading-snug">{cat.title}</h3>
                  <p class="text-[11px] text-muted-foreground">{cat.desc}</p>
                </div>
              </div>
              <span data-pill class="dd-pill dd-pill-dim text-[10px] uppercase font-bold shrink-0">
                Live
              </span>
            </div>

            <!-- Body Tabel Key-Value Data -->
            <div class="dd-card-body flex-1 text-xs sm:text-sm">
              <div class="dd-skeleton h-20 w-full"></div>
            </div>
          </div>
        );
      })}
    </div>
  </div>

  <script>
    import { initInfoDashboard } from '@/lib/diagnostics/info';

    document.addEventListener('astro:page-load', () => {
      initInfoDashboard();
    });
  </script>
</BaseLayout>

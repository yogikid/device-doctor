---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { 
  Battery, 
  Wifi, 
  Smartphone, 
  Monitor, 
  Cpu, 
  Database, 
  Sparkles, 
  Radio, 
  Film, 
  Camera, 
  Layers, 
  Gauge, 
  Globe 
} from 'lucide-react';

const specs = [
  { id: 'battery', icon: 'Battery', title: 'Baterai & Daya', desc: 'Status pengisian dan level persentase baterai real-time.' },
  { id: 'connection', icon: 'Wifi', title: 'Koneksi & Sinyal', desc: 'Status online, tipe jaringan (4G/5G/WiFi), downlink Mbps & RTT latency.' },
  { id: 'device', icon: 'Smartphone', title: 'Perangkat & CPU', desc: 'Arsitektur platform, jumlah CPU cores, RAM terdeteksi, dan touch points.' },
  { id: 'screen', icon: 'Monitor', title: 'Layar & Resolusi', desc: 'Resolusi fisik, Device Pixel Ratio (DPR), orientasi, dan preferensi tema OS.' },
  { id: 'gpu', icon: 'Cpu', title: 'GPU & Chipset', desc: 'Renderer kartu grafis dan vendor hardware via WebGL unmasked info.' },
  { id: 'storage', icon: 'Database', title: 'Penyimpanan (Origin)', desc: 'Alokasi kuota storage browser & pemakaian data lokal situs.' },
  { id: 'displayx', icon: 'Sparkles', title: 'Kualitas Display', desc: 'Pengukuran live refresh rate (Hz), color gamut P3, dan dukungan HDR.' },
  { id: 'sensors', icon: 'Radio', title: 'Sensor & Radio', desc: 'Ketersediaan Gyroscope, Accelerometer, Magnetometer, Bluetooth & NFC.' },
  { id: 'codecs', icon: 'Film', title: 'Codec Media & DRM', desc: 'Dukungan decoding video hardware (H.264, HEVC, VP9, AV1) & DRM Widevine.' },
  { id: 'mediadev', icon: 'Camera', title: 'Kamera & Audio', desc: 'Jumlah sensor kamera (depan/belakang) dan mikrofon fisik terdeteksi.' },
  { id: 'platform', icon: 'Layers', title: 'Platform & Web APIs', desc: 'PWA standalone, WebGL 2.0, WebGPU, WebAssembly, dan Secure Context.' },
  { id: 'memory', icon: 'Gauge', title: 'Memori JS Heap', desc: 'Pemakaian alokasi memori heap JavaScript engine (Chromium only).' },
  { id: 'locale', icon: 'Globe', title: 'Waktu & Locale', desc: 'Zona waktu sistem, bahasa browser, format tanggal, dan offset UTC.' },
];
---

<BaseLayout title="Spesifikasi Perangkat · Device Doctor" description="Inspeksi mendalam spesifikasi hardware dan Web APIs browser perangkat kamu.">
  <div class="flex flex-col gap-4">
    <!-- Header Banner -->
    <div class="dd-card p-4 bg-card flex flex-col gap-2 relative overflow-hidden" data-accent="neutral">
      <div class="flex items-center justify-between">
        <div>
          <h2 class="font-heading text-xl font-extrabold">Spesifikasi Hardware</h2>
          <p class="text-xs text-muted-foreground mt-0.5">Data teknis dibaca langsung dari Web APIs browser tanpa instalasi.</p>
        </div>
        <span class="dd-btn bg-main px-2.5 py-1 text-xs font-bold font-data">
          13 Modul
        </span>
      </div>
    </div>

    <!-- Grid Kartu Spesifikasi -->
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-3.5">
      {
        specs.map((item) => (
          <article
            id={`card-${item.id}`}
            class="dd-card relative flex flex-col gap-2.5 p-4 bg-card"
            data-accent="neutral"
            data-unsupported="false"
          >
            <div class="flex items-center justify-between border-b-2 border-border/40 pb-2">
              <div class="flex items-center gap-2">
                <div class="p-1.5 rounded-base bg-secondary-background border-2 border-border">
                  {item.icon === 'Battery' && <Battery className="w-4 h-4 text-primary" />}
                  {item.icon === 'Wifi' && <Wifi className="w-4 h-4 text-primary" />}
                  {item.icon === 'Smartphone' && <Smartphone className="w-4 h-4 text-primary" />}
                  {item.icon === 'Monitor' && <Monitor className="w-4 h-4 text-primary" />}
                  {item.icon === 'Cpu' && <Cpu className="w-4 h-4 text-primary" />}
                  {item.icon === 'Database' && <Database className="w-4 h-4 text-primary" />}
                  {item.icon === 'Sparkles' && <Sparkles className="w-4 h-4 text-primary" />}
                  {item.icon === 'Radio' && <Radio className="w-4 h-4 text-primary" />}
                  {item.icon === 'Film' && <Film className="w-4 h-4 text-primary" />}
                  {item.icon === 'Camera' && <Camera className="w-4 h-4 text-primary" />}
                  {item.icon === 'Layers' && <Layers className="w-4 h-4 text-primary" />}
                  {item.icon === 'Gauge' && <Gauge className="w-4 h-4 text-primary" />}
                  {item.icon === 'Globe' && <Globe className="w-4 h-4 text-primary" />}
                </div>
                <h3 class="font-heading text-sm font-bold tracking-tight">{item.title}</h3>
              </div>
            </div>

            <dl data-body class="flex flex-col">
              <div class="dd-skeleton h-4 w-3/4 mb-1.5" />
              <div class="dd-skeleton h-4 w-1/2" />
            </dl>

            <p data-note class="text-[11px] leading-relaxed text-muted-foreground border-t border-dashed border-border/30 pt-1.5">
              {item.desc}
            </p>
          </article>
        ))
      }
    </div>

    <!-- Raw User Agent Box -->
    <article class="dd-card p-4 bg-card flex flex-col gap-2" data-accent="neutral">
      <h3 class="font-heading text-xs font-bold uppercase tracking-wider text-muted-foreground">User Agent String (Mentah)</h3>
      <p data-ua class="font-data text-[11px] leading-relaxed break-all text-muted-foreground bg-secondary-background p-2.5 rounded-base border-2 border-border">
        Memuat user agent…
      </p>
    </article>
  </div>

  <script>
    import { initInfoDashboard } from '@/lib/diagnostics/info';

    // Berjalan saat inisialisasi awal maupun saat navigasi SPA (astro:page-load)
    document.addEventListener('astro:page-load', () => {
      initInfoDashboard();
    });
  </script>
</BaseLayout>

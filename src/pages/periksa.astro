---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { 
  Touchpad, 
  Tv, 
  Volume2, 
  Mic, 
  Camera, 
  Vibrate, 
  Compass, 
  Zap, 
  Navigation,
  Play
} from 'lucide-react';

const tests = [
  { id: 'touch', title: 'Layar Sentuh', desc: 'Uji multi-touch responsif 60 blok matriks layar penuh edge-to-edge.', icon: Touchpad },
  { id: 'display', title: 'Dead Pixel 8 Warna', desc: 'Uji spektrum 8 warna solid (RGB, White, Black, Cyan, Yellow, Magenta).', icon: Tv },
  { id: 'speaker', title: 'Speaker Stereo L/R', desc: 'Uji pemisahan kanal audio kiri (600 Hz) dan kanan (800 Hz).', icon: Volume2 },
  { id: 'mic', title: 'Mikrofon Real-Time', desc: 'Visualizer decibel meter respons input suara sekitar.', icon: Mic },
  { id: 'camera', title: 'Modul Kamera', desc: 'Uji sensor optik kamera utama belakang dan kamera depan.', icon: Camera },
  { id: 'vibrate', title: 'Motor Getar Haptic', desc: 'Uji getaran multi-pattern (Burst, SOS, Pulse, Long) W3C spec.', icon: Vibrate },
  { id: 'motion', title: 'Sensor Gerak (Gyro)', desc: 'Uji respon sudut kemiringan 3D leveling akselerometer & gyroscope.', icon: Compass },
  { id: 'benchmark', title: 'Benchmark CPU & GPU', desc: 'Stress test komputasi matematika floating-point matriks.', icon: Zap },
  { id: 'gps', title: 'Kuncian Sinyal GPS', desc: 'Uji ketepatan radius akurasi satelit GNSS perangkat.', icon: Navigation },
];
---

<BaseLayout 
  title="Periksa Hardware & Diagnostik Interaktif · Device Doctor"
  description="Uji coba interaktif 9 komponen fisik smartphone: Layar sentuh fullscreen, dead pixel 8 warna, speaker stereo kiri kanan, mikrofon, kamera, dan haptic getaran."
  keywords="tes layar hp online, uji dead pixel fullscreen, tes speaker stereo hp, cek getaran poco xiaomi, benchmark hp online"
>
  <div class="flex flex-col gap-6">
    <!-- Header Card -->
    <div class="dd-card p-5 sm:p-6 bg-card flex flex-col gap-2.5" data-accent="neutral">
      <div class="flex items-center gap-3">
        <div class="flex items-center justify-center w-11 h-11 rounded-base bg-main border-2 border-border shadow-xs shrink-0">
          <Touchpad className="w-6 h-6 text-foreground" />
        </div>
        <div>
          <h2 class="font-heading text-lg sm:text-xl md:text-2xl font-black">Periksa Komponen Fisik</h2>
          <p class="text-xs sm:text-sm text-muted-foreground">9 rangkaian pengujian interaktif untuk mendeteksi kerusakan fisik hardware.</p>
        </div>
      </div>
      <p class="text-xs sm:text-sm text-muted-foreground leading-relaxed pt-1">
        Pilih salah satu komponen di bawah untuk membuka simulasi pengujian layar penuh edge-to-edge.
      </p>
    </div>

    <!-- Grid Test: 1 Kolom di Mobile, 2 Kolom di Tablet, 3 Kolom di Desktop -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4 sm:gap-5 md:gap-6">
      {tests.map((t) => {
        const Icon = t.icon;
        return (
          <div class="dd-card p-4 sm:p-5 bg-card flex flex-col justify-between gap-4 h-full shadow-xs" data-accent="neutral">
            <div class="flex flex-col gap-2.5">
              <div class="flex items-center justify-between gap-2 border-b-2 border-border/40 pb-2.5">
                <div class="flex items-center gap-2.5">
                  <div class="p-2 rounded-base bg-secondary-background border-2 border-border shadow-2xs shrink-0">
                    <Icon className="w-4 h-4 sm:w-5 sm:h-5 text-foreground" />
                  </div>
                  <h3 class="font-heading text-sm sm:text-base font-extrabold">{t.title}</h3>
                </div>
                <span id={`badge-${t.id}`} class="dd-pill dd-pill-dim text-[10px] uppercase font-bold shrink-0">
                  Belum Diuji
                </span>
              </div>
              <p class="text-xs sm:text-sm text-muted-foreground leading-relaxed">{t.desc}</p>
            </div>

            <div class="flex flex-col gap-2 pt-2">
              <button
                type="button"
                id={`btn-${t.id}`}
                class="dd-btn bg-main py-2.5 sm:py-3 px-4 text-xs sm:text-sm font-extrabold flex items-center justify-center gap-2 w-full shadow-xs"
              >
                <Play className="w-3.5 h-3.5 sm:w-4 sm:h-4 text-foreground shrink-0 fill-current" />
                <span>Mulai Uji Coba</span>
              </button>
              <div id={`result-${t.id}`} class="hidden font-data text-[11px] sm:text-xs p-2 rounded-base bg-secondary-background border border-border"></div>
            </div>
          </div>
        );
      })}
    </div>
  </div>

  <script>
    import {
      startTouchTest,
      startDisplayTest,
      startSpeakerTest,
      startMicTest,
      startCameraTest,
      startVibrateTest,
      startMotionTest,
      startBenchmark,
      startGpsTest,
    } from '@/lib/diagnostics/tests';
    import { getSession } from '@/lib/diagnostics/store';

    function updateBadge(id: string, status: string, value?: string) {
      const badge = document.getElementById(`badge-${id}`);
      const resBox = document.getElementById(`result-${id}`);
      if (!badge) return;

      badge.classList.remove('dd-pill-dim', 'dd-pill-live');
      if (status === 'pass') {
        badge.textContent = 'Lolos Normal';
        badge.className = 'dd-pill bg-healthy text-black font-extrabold';
      } else if (status === 'fail') {
        badge.textContent = 'Bermasalah';
        badge.className = 'dd-pill bg-critical text-white font-extrabold';
      } else if (status === 'warn' || status === 'denied' || status === 'unsupported') {
        badge.textContent = 'Perhatian / Izin';
        badge.className = 'dd-pill bg-attention text-black font-extrabold';
      }

      if (resBox && value) {
        resBox.classList.remove('hidden');
        resBox.textContent = `Hasil: ${value}`;
      }
    }

    function syncAllBadges() {
      const session = getSession();
      for (const [id, entry] of Object.entries(session.entries)) {
        updateBadge(id, entry.status, entry.value);
      }
    }

    function bindEvents() {
      syncAllBadges();

      document.getElementById('btn-touch')?.addEventListener('click', () => {
        startTouchTest();
        setTimeout(syncAllBadges, 1000);
      });
      document.getElementById('btn-display')?.addEventListener('click', () => {
        startDisplayTest();
        setTimeout(syncAllBadges, 1000);
      });
      document.getElementById('btn-speaker')?.addEventListener('click', () => {
        startSpeakerTest();
        setTimeout(syncAllBadges, 1000);
      });
      document.getElementById('btn-mic')?.addEventListener('click', () => {
        startMicTest();
        setTimeout(syncAllBadges, 1000);
      });
      document.getElementById('btn-camera')?.addEventListener('click', () => {
        startCameraTest();
        setTimeout(syncAllBadges, 1000);
      });
      document.getElementById('btn-vibrate')?.addEventListener('click', () => {
        startVibrateTest();
        setTimeout(syncAllBadges, 1000);
      });
      document.getElementById('btn-motion')?.addEventListener('click', () => {
        startMotionTest();
        setTimeout(syncAllBadges, 1000);
      });
      document.getElementById('btn-benchmark')?.addEventListener('click', () => {
        startBenchmark();
        setTimeout(syncAllBadges, 1000);
      });
      document.getElementById('btn-gps')?.addEventListener('click', () => {
        startGpsTest();
        setTimeout(syncAllBadges, 1000);
      });
    }

    document.addEventListener('astro:page-load', () => {
      bindEvents();
    });
  </script>
</BaseLayout>

---
import '../styles/global.css';
import BottomNav from '@/components/BottomNav.tsx';
import { ClientRouter } from 'astro:transitions';

interface Props {
  title?: string;
  description?: string;
  keywords?: string;
  image?: string;
}

const {
  title = 'Device Doctor · Mobile Hardware Diagnostics & Web Specs Lab',
  description = 'Platform inspeksi mendalam hardware smartphone, deteksi IP/ISP, uji layar sentuh edge-to-edge, dead pixel solid 8 warna, motor getar haptic, dan diagnosa AI secara real-time langsung di browser.',
  keywords = 'device doctor, cek hp, tes layar sentuh, cek dead pixel, cek getar hp, spesifikasi hp online, cek isp ip publik, uji hardware smartphone, web diagnostics, ai hardware doctor, benchmark hp browser',
  image = 'https://device-doctor.abiding-warlock.workers.dev/icons/icon-512.png',
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site || 'https://device-doctor.abiding-warlock.workers.dev');

// Schema.org JSON-LD
const structuredData = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebApplication",
      "@id": `${canonicalURL.origin}/#webapp`,
      "name": "Device Doctor",
      "url": canonicalURL.origin,
      "description": description,
      "applicationCategory": "UtilitiesApplication",
      "operatingSystem": "Android, iOS, Windows, macOS, Linux",
      "browserRequirements": "Requires Modern Web Standards (HTML5, WebGL, Web Audio, Geolocation)",
      "offers": {
        "@type": "Offer",
        "price": "0",
        "priceCurrency": "IDR"
      },
      "featureList": [
        "Deteksi 14 Modul Spesifikasi Hardware & Jaringan Edge",
        "Uji Matriks Layar Sentuh Multi-Touch 60 Blok Edge-to-Edge",
        "Uji Dead Pixel 8 Spektrum Warna Solid Murni Fullscreen",
        "Uji Speaker Stereo Kiri & Kanan Terpisah",
        "Uji Multi-Pattern Vibration Motor (Haptics API)",
        "Peta Interaktif OpenStreetMap & Presisi Satelit GPS",
        "Analisis Medis Perangkat & Konsultasi Chatbot AI Cerdas"
      ],
      "inLanguage": "id-ID",
      "author": {
        "@type": "Person",
        "name": "Yogi",
        "url": "https://github.com/yogikid"
      }
    },
    {
      "@type": "WebSite",
      "@id": `${canonicalURL.origin}/#website`,
      "url": canonicalURL.origin,
      "name": "Device Doctor",
      "description": description,
      "inLanguage": "id-ID"
    }
  ]
};
---

<!doctype html>
<html lang="id">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#A7D7C5" />
    <meta name="color-scheme" content="light dark" />

    <!-- SEO Meta Tags Primer -->
    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={description} />
    <meta name="keywords" content={keywords} />
    <meta name="author" content="Yogi" />
    <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
    <link rel="canonical" href={canonicalURL.href} />

    <!-- Open Graph / Facebook / WhatsApp -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL.href} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={image} />
    <meta property="og:image:width" content="512" />
    <meta property="og:image:height" content="512" />
    <meta property="og:locale" content="id_ID" />
    <meta property="og:site_name" content="Device Doctor" />

    <!-- Twitter Cards -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={canonicalURL.href} />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:image" content={image} />

    <!-- Geo & Location Meta Tags -->
    <meta name="geo.region" content="ID" />
    <meta name="geo.placename" content="Indonesia" />
    <meta name="geo.position" content="-6.2088;106.8456" />
    <meta name="ICBM" content="-6.2088, 106.8456" />

    <!-- PWA & Mobile Web Capabilities -->
    <link rel="manifest" href="/manifest.webmanifest" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/icons/icon-192.png" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <meta name="apple-mobile-web-app-title" content="Device Doctor" />
    <meta name="mobile-web-app-capable" content="yes" />

    <!-- Schema.org JSON-LD Structured Data -->
    <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />

    <!-- Client Router untuk Navigasi Instan Bebas Kedip -->
    <ClientRouter />
  </head>

  <!-- Background Berpola Grid Retro Halus yang Transparan & Alami -->
  <body class="min-h-dvh bg-background text-foreground antialiased selection:bg-main selection:text-black [background-size:24px_24px] [background-image:linear-gradient(to_right,#0000000a_1px,transparent_1px),linear-gradient(to_bottom,#0000000a_1px,transparent_1px)]">
    
    <!-- Outer Container yang 100% Responsif Fluida Menyesuaikan Ukuran Device Apapun -->
    <div class="mx-auto flex min-h-dvh w-full max-w-7xl flex-col bg-card/95 backdrop-blur-xs border-x-0 md:border-x-[3px] border-border shadow-2xl relative pb-24 transition-all duration-200">
      
      <!-- App Header Responsif -->
      <header class="sticky top-0 z-30 flex items-center justify-between border-b-[3px] border-border bg-main px-4 sm:px-6 md:px-8 py-3.5 shadow-sm">
        <div class="flex items-center gap-3">
          <div class="flex items-center justify-center w-9 h-9 md:w-11 md:h-11 rounded-base bg-card border-2 md:border-[2.5px] border-border shadow-xs shrink-0">
            <svg class="w-5 h-5 md:w-6 md:h-6 text-foreground" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <path d="M4.8 2.3A.3.3 0 1 0 5 2H4a2 2 0 0 0-2 2v5a6 6 0 0 0 6 6v0a6 6 0 0 0 6-6V4a2 2 0 0 0-2-2h-1a.2.2 0 1 0 .3.3"/>
              <path d="M8 15v1a6 6 0 0 0 6 6v0a6 6 0 0 0 6-6v-4"/>
              <circle cx="20" cy="10" r="2"/>
            </svg>
          </div>
          <div>
            <h1 class="font-heading text-base sm:text-lg md:text-xl font-black leading-none tracking-tight text-foreground">Device Doctor</h1>
            <p class="text-[11px] sm:text-xs font-bold text-foreground/75 mt-0.5">Mobile Hardware Diagnostics & AI Lab</p>
          </div>
        </div>
        <div class="flex items-center gap-2">
          <span id="net-status" class="dd-btn px-3 py-1 font-data text-xs sm:text-sm bg-healthy font-extrabold shadow-xs">
            Online
          </span>
        </div>
      </header>

      <!-- Main Content Area: Grid Fluida yang Ramping di HP dan Melebar Elegan di Tablet/Desktop -->
      <main class="flex-1 p-3.5 sm:p-6 md:p-8 lg:p-10 w-full">
        <slot />
      </main>

      <!-- Bottom Navigasi Multi-Page Modern -->
      <BottomNav client:load currentPath={Astro.url.pathname} />
    </div>

    <!-- Overlay Test Penuh -->
    <div
      id="test-overlay"
      class="fixed inset-0 z-50 hidden data-[active=true]:block bg-black/80 backdrop-blur-xs select-none touch-none"
      data-active="false"
    ></div>

    <script src="/registerSW.js" is:inline></script>
  </body>
</html>
